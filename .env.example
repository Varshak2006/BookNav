# ==============================================================================
# BOOKNAV — INTELLIGENT LIBRARY SEARCH SYSTEM CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust variables to suit your local deployment.

# Node Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGO_URI=mongodb://localhost:27017/book
SESSION_SECRET=your_secure_random_session_secret_change_in_production

# Optional Admin Setup Token (Required to create admins after first bootstrap admin)
ADMIN_SETUP_TOKEN=your_secure_admin_bootstrap_token

# Python Bridge Executable Paths
LACS_PYTHON=python
PYTHON_PATH=python

# Bridge Request Timeout Thresholds (milliseconds)
LACS_TIMEOUT_MS=5000
FAISS_TIMEOUT_MS=30000

# Embedding & Search Hyperparameters
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
FAISS_METRIC=inner_product
SEMANTIC_RELEVANCE_THRESHOLD=0.50

# Offline Mode for Hugging Face Cache (1 = Offline, 0 = Online)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Frontend Configuration (for client/.env)
VITE_API_BASE_URL=http://localhost:5000/api
